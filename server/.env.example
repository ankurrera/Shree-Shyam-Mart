# ==============================================================================
# SHREE SHYAM MART: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your local or production secrets.
# NEVER commit the actual .env file or sensitive secrets to version control.
# ==============================================================================

# Server Environment & Port Configuration
PORT=4000
NODE_ENV=development
TRUST_PROXY=false
CLIENT_URL=http://localhost:5173

# Database & Supabase Configuration (PostgreSQL)
# Option A: Direct PostgreSQL Connection String (Supabase Connection Pooler or Direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Supabase API Access (Publishable Key, Secret Key, & JWKS URL)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
# Legacy Supabase keys (if applicable)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authentication Security Configuration
# Minimum 32-character high-entropy secret required in production
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_long

# Seller / Admin Dashboard Credentials
SELLER_EMAIL=seller@shreeshyammart.com
SELLER_PASSWORD=YourStrongSellerPassword123!

# Cloudinary Cloud Asset Storage (Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
